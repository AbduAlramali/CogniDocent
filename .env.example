# ==============================================================================
# CogniDocent Environment Variables
# ==============================================================================

# Application Configuration
APP_NAME=CogniDocent
APP_ENV=development
APP_LOG_LEVEL=20

# Database Configuration (PostgreSQL + pgvector)
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=postgres
DB_PORT=5432
DB_NAME=cognidocent
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cognidocent

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Celery / RabbitMQ Broker
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//

# MinIO / S3 Object Storage Configuration
MINIO_ENDPOINT=localhost:9000
MINIO_EXTERNAL_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_REGION=us-east-1
MINIO_INCOMING_UPLOADS_BUCKET=uploads
MINIO_QUARANTINE_BUCKET=quarantine
MINIO_TRUSTED_BUCKET=trusted
MINIO_INFECTED_BUCKET=infected
MINIO_THUMBNAILS_BUCKET=thumbnails
MINIO_SECURE=false

# ClamAV Configuration
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# AI LLM Provider API Keys (Can also be set in Settings UI)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434

# Frontend Configuration
VITE_API_URL=/api/v1
